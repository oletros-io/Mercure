# Mercure Configuration

# DNS
DNS_TIMEOUT=5.0

# Threads
DEFAULT_THREADS=16
SELECTOR_THREADS=16

# DKIM
DKIM_WORDLIST_PATH=resources/dkim_selectors.txt

# SMTP (Ghost Sender probe + direct spoof)
SMTP_TIMEOUT=10.0

# SMTP Relay (authenticated relay for spoof mode)
SMTP_RELAY_HOST=ssl0.ovh.net
SMTP_RELAY_PORT=465
SMTP_RELAY_USER=
SMTP_RELAY_PASS=

# Logging
LOG_DIR=log
LOG_RETENTION_DAYS=30
